generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  email     String?
  phone     String?
  address   String?
  status    String   @default("actif") // "actif" | "suspendu"

  // Assistant de configuration initiale (état au niveau de l'organisation, pas de l'utilisateur :
  // un 2e administrateur ne doit pas reconfigurer une organisation déjà prête).
  onboardingStatus        String    @default("non_commence") // "non_commence" | "en_cours" | "termine"
  onboardingStep          String?   // étape courante, voir ONBOARDING_STEPS (lib/onboarding/steps.ts)
  onboardingSkippedSteps  String[]  @default([])
  onboardingCompletedAt   DateTime?
  onboardingCompletedById String?   // traçabilité seule, sans clé étrangère (comme AuditLog.actorId)

  centers   Center[]
  users     User[]
  roles     Role[]
  formations Formation[]
  classes   ClassGroup[]
  students  Student[]
  payments  Payment[]
  expenses  Expense[]
  schedules PaymentSchedule[]
  subscription Subscription?
  platformPayments PlatformPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Center {
  id             String       @id @default(uuid())
  name           String
  address        String?
  status         String       @default("actif")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  classes        ClassGroup[]
  expenses       Expense[]

  users          User[]       @relation("CenterUsers")
  formations     Formation[]  @relation("FormationCenters")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id             String        @id @default(uuid())
  matricule      String        @unique
  firstName      String
  lastName       String
  email          String        @unique
  passwordHash   String
  avatarUrl      String?
  roles          String[]      // ["ADMIN", "GESTIONNAIRE", "COMPTABLE"]
  isSuperAdmin   Boolean       @default(false)
  status         String        @default("actif")
  lastLoginAt    DateTime?
  // true quand le mot de passe a été fixé par quelqu'un d'autre (création, réinitialisation) :
  // l'utilisateur doit le changer avant d'accéder à l'application.
  mustChangePassword Boolean   @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  centers        Center[]      @relation("CenterUsers")

  payments       Payment[]
  expenses       Expense[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Formation {
  id             String       @id @default(uuid())
  name           String
  duration       Int
  hasLevels      Boolean      @default(false)
  levelCount     Int?
  levels         Json?
  totalCost      Float
  status         String       @default("actif")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  classes        ClassGroup[]
  // Centres où la formation est proposée (au moins un) : une classe de cette formation ne peut
  // être ouverte que dans l'un d'eux, et le périmètre des utilisateurs s'appuie dessus.
  centers        Center[]     @relation("FormationCenters")
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ClassGroup {
  id             String       @id @default(uuid())
  name           String
  status         String       @default("ouverte")
  capacity       Int
  startDate      DateTime?
  endDate        DateTime?

  formationId    String
  formation      Formation    @relation(fields: [formationId], references: [id], onDelete: Cascade)
  
  centerId       String
  center         Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  students       Student[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Student {
  id              String       @id @default(uuid())
  matricule       String
  firstName       String
  lastName        String
  contact         String
  email           String?
  gender          String
  currentStatus   String       @default("en_cours")
  currentLevel    String?
  enrollmentDate  DateTime     @default(now())
  progressionLogs Json?

  classId         String
  classGroup      ClassGroup   @relation(fields: [classId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  payments        Payment[]
  schedules       PaymentSchedule[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([matricule, organizationId])
}

model PaymentSchedule {
  id                  String       @id @default(uuid())
  totalAmount         Float
  paidAmount          Float
  remainingAmount     Float
  status              String       @default("en_retard")
  registrationFee     Float        @default(0)
  installmentsCount   Int          @default(0)
  installmentInterval String       @default("1_mois")
  installments        Json?
  
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Payment {
  id             String       @id @default(uuid())
  amount         Float
  date           DateTime     @default(now())
  method         String
  motif          String?
  reference      String?

  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  recordedById   String
  recordedBy     User         @relation(fields: [recordedById], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Expense {
  id             String       @id @default(uuid())
  title          String
  category       String
  amount         Float
  date           DateTime     @default(now())
  description    String?

  recordedById   String
  recordedBy     User         @relation(fields: [recordedById], references: [id])

  centerId       String
  center         Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  price       Float    @default(0)
  maxCenters  Int      @default(1)
  maxStudents Int      @default(50)
  isUnlimitedCenters Boolean  @default(false)
  isUnlimitedStudents Boolean @default(false)
  isPopular   Boolean  @default(false)
  features    Json?
  unavailableFeatures Json?
  
  subscriptions Subscription[]
  platformPayments PlatformPayment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  planId         String?
  plan           Plan?        @relation(fields: [planId], references: [id])
  
  status         String       @default("trial")   // "active", "trial", "expired", "suspended"
  startDate      DateTime     @default(now())
  endDate        DateTime
  maxCenters     Int          @default(3)
  maxStudents    Int          @default(200)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actorEmail  String
  actorName   String
  action      String   // e.g. "ORGANIZATION_CREATED", "ORGANIZATION_SUSPENDED", "ADMIN_LOGIN"
  resource    String   // "Organization", "User", "Subscription", "Security"
  resourceId  String?
  details     Json?    // Metadata, previous/new values, IP, etc.
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model PlatformPayment {
  id             String       @id @default(uuid())
  amount         Float
  status         String       @default("COMPLETED") // "COMPLETED" | "FAILED" | "PENDING"
  date           DateTime     @default(now())
  currency       String       @default("FCFA")
  reference      String       @default("") @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId         String?
  plan           Plan?        @relation(fields: [planId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Role {
  id             String        @id @default(uuid())
  name           String
  description    String?
  isSystem       Boolean       @default(false)
  /// Rôle système copié dans l'organisation (GESTIONNAIRE, COMPTABLE) : nom figé, permissions
  /// modifiables, "Rétablir les réglages d'origine" possible. Null pour les rôles créés par l'organisation.
  systemKey      String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  permissions    RolePermission[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([name, organizationId])
}

model RolePermission {
  id        String   @id @default(uuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  resource  String
  canRead   Boolean  @default(false)
  canWrite  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([roleId, resource])
}
