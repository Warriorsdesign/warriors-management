# Copy this file to `.env` and replace the placeholders with real values.
# Requires PostgreSQL >= 15 (Supabase).

# Runtime app connection (RLS-enforced, app_user role - transaction pooler, port 6543)
DATABASE_URL="postgresql://app_user.<project_ref>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations only (Prisma CLI: db push / migrate) - privileged role, session pooler, port 5432
DIRECT_URL="postgresql://postgres.<project_ref>:<password>@<host>.pooler.supabase.com:5432/postgres"

# Auth-only connection (login lookup by email before org_id is known, app_auth role)
AUTH_DATABASE_URL="postgresql://app_auth.<project_ref>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT signing secret for the custom auth_token cookie (src/lib/auth/jwt.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SUPABASE_JWT_SECRET="<random-secret>"
