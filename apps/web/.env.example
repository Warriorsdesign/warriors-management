# Local development: run `npm run db:setup:local` to create the database,
# provision isolated roles, apply the current Prisma schema, and write apps/web/.env.
#
# For Neon, replace only these two URLs with the pooled runtime connection and
# the direct connection respectively. Keep the same role separation and RLS.
DATABASE_URL="postgresql://app_user:<password>@127.0.0.1:5432/warriors_management?schema=public"
DIRECT_URL="postgresql://warriors_admin:<password>@127.0.0.1:5432/warriors_management?schema=public"

# JWT signing secret for the application's httpOnly auth cookies.
JWT_SECRET="<random-secret>"
